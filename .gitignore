# Large or regenerable outputs: recreate with scripts/01-07
data/
checkpoints/

# Copyrighted book PDF: never publish
*.pdf

# Tokenizer experiments: only the chosen tokenizer and the comparison are versioned
tokenizer/oromo-bpe-*.json
tokenizer/naolbm-oromo-bbpe/

# Python / OS
__pycache__/
*.pyc
.pytest_cache/
.venv/
.ipynb_checkpoints/
.DS_Store

# Paper build outputs (rebuild with sh paper/build.sh)
paper/*.aux
paper/*.log
paper/*.blg
paper/*.out
paper/arxiv-source.tar.gz

# The paper and its figures are published (the *.pdf rule above keeps the book out)
!paper/main.pdf
!paper/figures/*.pdf
